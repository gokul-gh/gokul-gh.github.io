---
interface Props {
  title: string;
  description: string;
  techStack: string[];
  badges: { label: string; color: string }[];
  image: string;
}

const { title, description, techStack, badges, image } = Astro.props;
---
<article class="group relative bg-dark-800 rounded-xl overflow-hidden border border-dark-700 hover:border-primary-600/50 transition-all duration-300 hover:shadow-lg hover:shadow-primary-900/20 hover:-translate-y-1">
  <div class="aspect-video overflow-hidden bg-dark-700">
    <img
      src={image}
      alt={title}
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-dark-950/80 via-dark-950/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
  </div>

  <div class="p-6">
    <h3 class="text-xl font-semibold text-white group-hover:text-primary-300 transition-colors mb-2">{title}</h3>
    <p class="text-dark-300 text-sm leading-relaxed mb-4 line-clamp-3">{description}</p>

    <div class="flex flex-wrap gap-2 mb-4">
      {techStack.map((tech) => (
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-primary-900/40 text-primary-200 border border-primary-700/50">
          {tech}
        </span>
      ))}
    </div>

    <div class="flex flex-wrap gap-2">
      {badges.map((badge) => (
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-dark-700 text-dark-200 border border-dark-600">
          {badge.label}
        </span>
      ))}
    </div>

    <div class="mt-6 flex items-center gap-4">
      <a
        href={techStack.length ? `#` : '#'}
        class="inline-flex items-center gap-1.5 text-sm font-medium text-dark-300 hover:text-primary-300 transition-colors"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
        View details
      </a>
    </div>
  </div>
</article>