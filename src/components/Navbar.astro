---
const navLinks = [
  { href: '#about', label: 'About' },
  { href: '#skills', label: 'Skills' },
  { href: '#projects', label: 'Projects' },
  { href: '#contact', label: 'Contact' },
  { href: '/Gokul-Resume.pdf', label: 'Resume', external: true },
];
---

<nav
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 bg-dark-900/90 backdrop-blur-lg border-b border-dark-700 transition-all duration-300"
  aria-label="Main navigation"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a
        href="#"
        class="flex items-center gap-2 text-xl font-bold tracking-tight text-white hover:opacity-80 transition-opacity"
        aria-label="Gokul — Home"
      >
        <span class="gradient-text">G</span>
        <span class="hidden sm:block">Gokul</span>
      </a>

      <!-- Desktop Nav -->
      <div class="hidden md:flex items-center gap-1">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class={[
              'px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200',
              'hover:bg-primary-500/10 hover:text-primary-300',
              link.external ? 'text-accent-400 hover:text-accent-300' : 'text-dark-300',
            ].join(' ')}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- Mobile Menu Toggle -->
      <button
        id="menu-toggle"
        class="md:hidden p-2 rounded-lg text-dark-300 hover:text-white hover:bg-dark-800 transition-colors"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <!-- Mobile Nav -->
    <div
      id="mobile-menu"
      class="md:hidden hidden py-4 border-t border-dark-700"
      role="navigation"
      aria-label="Mobile navigation"
    >
      <div class="flex flex-col gap-2">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class={[
              'px-4 py-3 rounded-lg text-base font-medium transition-all duration-200',
              'hover:bg-primary-500/10 hover:text-primary-300',
              link.external ? 'text-accent-400 hover:text-accent-300' : 'text-dark-300',
            ].join(' ')}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</nav>

<style>
  /* Scroll effect */
  nav.scrolled {
    @apply bg-dark-900/95 shadow-lg;
  }
</style>