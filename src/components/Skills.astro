---
const skills = [
  { name: 'Java', category: 'languages', level: 90 },
  { name: 'JavaScript', category: 'languages', level: 95 },
  { name: 'TypeScript', category: 'languages', level: 85 },
  { name: 'SQL', category: 'databases', level: 80 },
  { name: 'Spring Boot', category: 'frameworks', level: 90 },
  { name: 'React', category: 'frameworks', level: 95 },
  { name: 'Ionic React', category: 'frameworks', level: 80 },
  { name: 'PostgreSQL', category: 'databases', level: 75 },
  { name: 'Docker', category: 'tools', level: 85 },
  { name: 'Git/GitHub', category: 'tools', level: 90 },
  { name: 'Postman', category: 'tools', level: 80 },
  { name: 'Bash', category: 'languages', level: 70 },
];
---
<section id="skills" class="py-16 bg-dark-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-4xl font-bold text-white mb-12 text-center">My Skills</h2>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
      {skills.map((skill) => (
        <div class="bg-dark-800 border border-dark-700 rounded-lg px-4 py-3 text-dark-100 font-medium hover:border-primary-500/30 hover:bg-dark-700 transition-colors">
          <div class="flex items-center justify-between mb-1">
            <span>{skill.name}</span>
            <span class="text-xs text-dark-400 ml-2">Level {skill.level}%</span>
          </div>
          <div class="w-full bg-dark-700 rounded-full h-1.5 overflow-hidden">
            <div
              class="bg-gradient-to-r from-primary-500 to-accent-500 h-1.5 rounded-full"
              style={{ width: `${skill.level}%` }}
            ></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>