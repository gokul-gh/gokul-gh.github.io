---
import { getCollection } from 'astro:content';
import ProjectCard from '../components/ProjectCard.astro';
const projects = await getCollection('projects');
---
<section id="projects" class="py-16" style="background-color: var(--bg);">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-4xl font-bold text-center mb-4" style="color: var(--text);">Projects</h2>
    <p class="text-center mb-12 max-w-2xl mx-auto" style="color: var(--text-muted);">Internal company projects I've contributed to</p>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map(project => (
        <ProjectCard
          title={project.data.title}
          description={project.data.description}
          techStack={project.data.tech}
        />
      ))}
    </div>
  </div>
</section>